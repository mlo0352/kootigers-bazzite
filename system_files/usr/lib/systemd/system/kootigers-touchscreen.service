[Unit]
Description=KooTigers Goodix GDIX1002 Touchscreen Initialization
Documentation=https://github.com/mlo0352/kootigers-bazzite
After=systemd-modules-load.service systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/kootigers-touchscreen
RemainAfterExit=yes
TimeoutStartSec=50

[Install]
WantedBy=multi-user.target
